# Copy to .env (already git-ignored). Only set keys for providers you use.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Optional: comma-separated models in fallback order
# ORGANIZER_MODELS=gemini/gemini-2.5-flash,ollama/llama3.2

# Optional custom endpoints
# ORGANIZER_OPENAI_BASE_URL=https://api.openai.com/v1
# ORGANIZER_ANTHROPIC_BASE_URL=https://api.anthropic.com
# ORGANIZER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ORGANIZER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# ORGANIZER_GROQ_BASE_URL=https://api.groq.com/openai/v1
# ORGANIZER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ORGANIZER_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# ORGANIZER_OLLAMA_BASE_URL=http://localhost:11434/v1

# Conservative desktop scanning and plan-sanity limits
# ORGANIZER_MAX_FILES=10000
# ORGANIZER_MAX_FILE_MB=2048
# ORGANIZER_MAX_ARCHIVE_ENTRIES=1000
# ORGANIZER_RECENT_SECONDS=5
# ORGANIZER_SKIP_PARTIAL=1
# ORGANIZER_SKIP_HIDDEN_SYSTEM=1
# ORGANIZER_MAX_PLAN_FOLDERS=8
# ORGANIZER_PLAN_CONCENTRATION=0.85
# ORGANIZER_PLAN_MISC_RATIO=0.4
